      ]
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 56901,
      "end_ms": 58379,
      "text": "Что и подтверждается.",
      "emotion_probabilities": [
        0.9990794658660889,
        4.8447621520608664E-4,
        1.1870313755935058E-4,
        3.1730273622088134E-4
      ]
    },
    {
      "speaker_id": "speaker_2",
