# Only attach to the top-level CLI, after upstream has declared its targets.
if(CMAKE_SOURCE_DIR STREQUAL PROJECT_SOURCE_DIR)
    set(VEXTO_CLI_GUARD_SOURCE "${CMAKE_CURRENT_LIST_DIR}/parent_death.cpp")
    function(vexto_attach_cli_guard)
        foreach(cli whisper-cli llama-completion)
            if(TARGET ${cli})
                target_sources(${cli} PRIVATE "${VEXTO_CLI_GUARD_SOURCE}")
            endif()
        endforeach()
        # App workers retain their model/context across bounded mailbox requests.
        if(TARGET whisper)
            add_executable(vexto_whisper_exec "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/whisper_main.cpp" "${VEXTO_CLI_GUARD_SOURCE}")
            target_include_directories(vexto_whisper_exec PRIVATE "${CMAKE_SOURCE_DIR}/examples")
            target_link_libraries(vexto_whisper_exec PRIVATE whisper ${CMAKE_THREAD_LIBS_INIT})
            target_compile_features(vexto_whisper_exec PRIVATE cxx_std_17)
            target_link_options(vexto_whisper_exec PRIVATE "LINKER:-z,max-page-size=16384")
        elseif(TARGET llama)
            add_executable(vexto_llama_exec "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/llama_main.cpp" "${VEXTO_CLI_GUARD_SOURCE}")
            target_include_directories(vexto_llama_exec PRIVATE "${CMAKE_SOURCE_DIR}/vendor/nlohmann")
            target_link_libraries(vexto_llama_exec PRIVATE llama-common llama ${CMAKE_THREAD_LIBS_INIT})
            target_compile_features(vexto_llama_exec PRIVATE cxx_std_17)
            target_link_options(vexto_llama_exec PRIVATE "LINKER:-z,max-page-size=16384")
        endif()
    endfunction()
    cmake_language(DEFER CALL vexto_attach_cli_guard)
endif()
